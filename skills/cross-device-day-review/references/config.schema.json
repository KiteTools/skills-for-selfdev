{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day review config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "enum": [
              "device",
              "self_report",
              "machine"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "timezone",
    "sources"
  ]
}
